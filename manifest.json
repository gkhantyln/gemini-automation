{
   "action": {
      "default_title": "GEMINI AUTOMATION - Auto for Google Gemini"
   },
   "author": {
      "email": "gkhantyln@github.com"
   },
   "background": {
      "service_worker": "service-worker-loader.js",
      "type": "module"
   },
   "content_scripts": [
      {
         "all_frames": false,
         "js": [
            "assets/index.ts-B5Vf3eNf.js"
         ],
         "matches": [
            "*://gemini.google.com/*"
         ],
         "run_at": "document_end"
      }
   ],
   "description": "Auto Google Gemini™ for your prompts at scale. Batch generate and auto-download responses and images on Gemini.Google.com.",
   "host_permissions": [
      "*://gemini.google.com/*"
   ],
   "icons": {
      "128": "src/assets/logo.png",
      "16": "src/assets/logo.png",
      "24": "src/assets/logo.png",
      "32": "src/assets/logo.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "GEMINI AUTOMATION - Auto for Google Gemini",
   "offline_enabled": true,
   "permissions": [
      "storage",
      "tabs",
      "background",
      "sidePanel",
      "activeTab",
      "downloads",
      "debugger"
   ],
   "side_panel": {
      "default_path": "src/ui/side-panel/index.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.0.0",
   "version_name": "2.0",
   "web_accessible_resources": [
      {
         "matches": [
            "*://gemini.google.com/*"
         ],
         "resources": [
            "assets/catchUploadFile.ts-CDtmzXS_.js",
            "assets/index.ts-B5Vf3eNf.js"
         ],
         "use_dynamic_url": false
      }
   ]
}